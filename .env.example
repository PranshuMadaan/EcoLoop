# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / PostGIS)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecoloop_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=ecoloop_db

# Connection Pool Settings
PG_MAX_POOL=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=2000

# Authentication & Cryptography Secrets
JWT_SECRET=ecoloop_super_secret_jwt_key_2026_dev_auth
JWT_EXPIRES_IN=7d
COOKIE_SECRET=ecoloop_secure_cookie_signer_secret
EPR_HASH_SECRET=cpcb_epr_audit_hash_salt_key_2026

# Bank & UPI Verification Gateway (NPCI / Penny-Drop)
# Options: 'simulator' (default for local dev/testing), 'cashfree', 'razorpay', 'setu'
BANK_VERIFY_PROVIDER=simulator

# Cashfree Verification Suite
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox # 'sandbox' or 'production'

# RazorpayX Account Validation
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Setu UPI & Bank Account Verification
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=
SETU_ENV=sandbox # 'sandbox' or 'production'
